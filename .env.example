# Bee node API endpoint (light node is sufficient for uploading)
BEE_API=http://localhost:1633

# Postage batch ID used for uploads. Create one with:
#   swarm-cli stamp buy --depth 20 --amount 100000000
# Swarm storage is RENTED — monitor TTL with `swarm-cli stamp list` and top up.
SWARM_BATCH_ID=

# Public gateway for reads.
#
# Use bzz.limo, not download.gateway.ethswarm.org. Both return the same bytes,
# but the download gateway sends `Content-Disposition: attachment`, so browsers
# save pages instead of rendering them — which breaks the web viewer entirely.
# bzz.limo serves `inline` with the right Content-Type and CORS `*`.
SWARM_GATEWAY=https://bzz.limo

# Required to push. The e2e tests skip without them, which reads as a pass, so
# they belong here even though the file is only a template.
#
# SWARM_OWNER is the feed owner's Ethereum address (40 hex, with or without 0x).
# SWARM_PRIVATE_KEY is the key that signs feed updates — it is what proves a ref
# came from you. Treat it as a secret; .env is gitignored for this reason.
SWARM_OWNER=
SWARM_PRIVATE_KEY=

# Silences the one-time "uploads are permanent" warning on a first push. Set it
# in automation, not on a workstation: the warning is the only place the
# irreversibility is stated at the moment it becomes true.
# SWARM_NO_WARN=1

# Refuse to publish packs to a mutable postage batch (default). A mutable batch
# drops its oldest chunks once it fills, so pushes keep succeeding while older
# packs stop resolving. Set to 1 only if losing history is acceptable.
# SWARM_ALLOW_MUTABLE_BATCH=1
