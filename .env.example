# Bee node API endpoint (light node is sufficient for uploading)
BEE_API=http://localhost:1633

# Postage batch ID used for uploads. Create one with:
#   swarm-cli stamp buy --depth 20 --amount 100000000
# Swarm storage is RENTED — monitor TTL with `swarm-cli stamp list` and top up.
SWARM_BATCH_ID=

# Public gateway for reads.
#
# Use bzz.limo, not download.gateway.ethswarm.org. Both return the same bytes,
# but the download gateway sends `Content-Disposition: attachment`, so browsers
# save pages instead of rendering them — which breaks the web viewer entirely.
# bzz.limo serves `inline` with the right Content-Type and CORS `*`.
SWARM_GATEWAY=https://bzz.limo
