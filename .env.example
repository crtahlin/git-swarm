# Bee node API endpoint (light node is sufficient for uploading)
BEE_API=http://localhost:1633

# Postage batch ID used for uploads. Create one with:
#   swarm-cli stamp buy --depth 20 --amount 100000000
# Swarm storage is RENTED — monitor TTL with `swarm-cli stamp list` and top up.
SWARM_BATCH_ID=

# Public gateway used to verify that a plain `git clone` works for third parties
SWARM_GATEWAY=https://download.gateway.ethswarm.org
